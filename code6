def unbounded_knapsack(items, capacity):
    """
    完全背包: 物品可以重复选无限次。
    关键区别: 把内层循环从 0→capacity 改为正序 (而非倒序)。
    原理: 正序遍历时, dp[c-w] 可能已经包含了第 i 件物品 → 允许重复。
    """
    dp = [0] * (capacity + 1)
    
    for item in items:
        w, v = item["weight"], item["value"]
        for c in range(w, capacity + 1):  # 正序! 这就是区别所在
            dp[c] = max(dp[c], dp[c - w] + v)
    
    return dp[capacity]


def demo_unbounded_knapsack():
    """对比 0-1 背包 vs 完全背包。"""
    print("\n" + "=" * 70)
    print("独立研究②: 完全背包 vs 0-1 背包")
    print("=" * 70)
    
    # 用凑硬币的例子 (面额可重复 = 完全背包凑硬币)
    coins = [1, 5, 11]
    amount = 15
    
    # 完全背包凑硬币 (最少枚数)
    INF = float('inf')
    dp_unbounded = [INF] * (amount + 1)
    dp_unbounded[0] = 0
    for c in range(1, amount + 1):  # 正序 → 可重复
        for coin in coins:
            if c >= coin:
                dp_unbounded[c] = min(dp_unbounded[c], dp_unbounded[c - coin] + 1)
    
    print(f"\n凑硬币问题 (面额 {coins}, 金额 {amount}):")
    print(f"  完全背包 (可重复选): 最少 {dp_unbounded[amount]} 枚 (和 0-1 背包结果相同, 因为硬币本来就可重复)")
    
    # 关键行对比
    print(f"\n完全背包 vs 0-1 背包的代码区别 (内层循环顺序):")
    print(f"  0-1 背包: for c in range(capacity, w-1, -1)  # 倒序 → 每件物品最多用一次")
    print(f"  完全背包: for c in range(w, capacity+1)       # 正序 → 每件物品可用无限次")
    print(f"\n原因: 倒序遍历时 dp[c-w] 还没算过当前物品 → 只能用一次;")
    print(f"      正序遍历时 dp[c-w] 可能已经包含当前物品 → 可以重复用。")


