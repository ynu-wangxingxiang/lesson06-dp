# 原始背包数据
ITEMS = [
    {"name": "帐篷", "weight": 300, "value": 90},
    {"name": "炉具", "weight": 200, "value": 60},
    {"name": "睡袋", "weight": 350, "value": 115},
    {"name": "食物", "weight": 400, "value": 120},
    {"name": "水具", "weight": 250, "value": 80},
]


def knapsack_01(items, capacity, print_table=True):
    """
    0-1 背包动态规划。
    dp[i][c] = max(不带第i件, 带第i件)
    返回: 最大重要度, 选中物品列表, dp表
    """
    n = len(items)
    
    # dp[i][c]: 前 i 件、限重 c 时的最大重要度
    # 用 (n+1) x (capacity+1) 表方便处理第0行全0
    dp = [[0] * (capacity + 1) for _ in range(n + 1)]
    
    for i in range(1, n + 1):
        w_i = items[i - 1]["weight"]
        v_i = items[i - 1]["value"]
        for c in range(capacity + 1):
            # 不带第 i 件：答案继承正上方 dp[i-1][c]
            not_take = dp[i - 1][c]
            # 带第 i 件（前提 c >= w_i）
            take = dp[i - 1][c - w_i] + v_i if c >= w_i else 0
            # 两种取大
            dp[i][c] = max(not_take, take)
    
    # 回溯找选中的物品
    selected = []
    c = capacity
    for i in range(n, 0, -1):
        if dp[i][c] != dp[i - 1][c]:  # 不一样说明第 i 件被选了
            selected.append(items[i - 1])
            c -= items[i - 1]["weight"]
    
    selected.reverse()
    
    if print_table:
        print_knapsack_table(dp, items, capacity, selected)
    
    return dp[n][capacity], selected, dp


def print_knapsack_table(dp, items, capacity, selected):
    """打印背包 DP 表，并标出回溯路径。"""
    n = len(items)
    
    print(f"\n背包 DP 表 (容量 {capacity}g):")
    print("=" * 80)
    
    # 打印表头（容量档位）
    col_width = 6
    header = "物品\\容量".ljust(10)
    for c in range(0, capacity + 1, 100):
        header += f"{c:>{col_width}}"
    print(header)
    print("-" * 80)
    
    # 打印每一行
    for i in range(n + 1):
        if i == 0:
            row_label = "前0件".ljust(10)
        else:
            name = items[i - 1]["name"]
            w = items[i - 1]["weight"]
            v = items[i - 1]["value"]
            row_label = f"{name}({w}g/{v})".ljust(10)
        
        row_values = ""
        for c in range(0, capacity + 1, 100):
            row_values += f"{dp[i][c]:>{col_width}}"
        print(row_label + row_values)
    
    print("=" * 80)
    
    # 标出回溯路径
    print("\n回溯路径 (从 dp[5][1000] 向左上追踪):")
    c = capacity
    path_rows = []
    for i in range(n, 0, -1):
        if dp[i][c] != dp[i - 1][c]:
            path_rows.append((i, items[i - 1]["name"], items[i - 1]["weight"], items[i - 1]["value"], c))
            c -= items[i - 1]["weight"]
    path_rows.reverse()
    
    for idx, (i, name, w, v, cap_left) in enumerate(path_rows):
        print(f"  步骤{idx+1}: dp[{i}][{cap_left + w}] != dp[{i-1}][{cap_left + w}] → 选中 {name} ({w}g, {v}) → 剩余容量 {cap_left}g")
    
    print(f"\n选中组合: {[s['name'] for s in selected]}")
    total_weight = sum(s['weight'] for s in selected)
    total_value = sum(s['value'] for s in selected)
    print(f"总重量: {total_weight}g / 总重要度: {total_value}")
    
    # 最后一行
    print(f"\ndp 表最后一行 (前5件, 各容量):")
    last_row = dp[n]
    for c in range(0, capacity + 1, 100):
        marker = " ← 最大" if c == capacity else ""
        print(f"  容量{c}g: dp[5][{c}] = {last_row[c]}{marker}")


