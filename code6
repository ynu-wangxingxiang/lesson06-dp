# 自主实践 ②: 必投项目约束
# ============================================================

def knapsack_with_required(items, capacity, required_names):
    """
    0-1 背包变体: 某些物品「必选」。
    做法: 先把必选物品的重量和价值扣除, 对剩余物品 + 剩余容量跑标准 0-1 背包。
    """
    required = [it for it in items if it["name"] in required_names]
    optional = [it for it in items if it["name"] not in required_names]
    
    req_weight = sum(r["weight"] for r in required)
    req_value = sum(r["value"] for r in required)
    
    if req_weight > capacity:
        print(f"❌ 必选物品总重 {req_weight}g 超过容量 {capacity}g, 无解!")
        return None, None
    
    remaining_cap = capacity - req_weight
    
    # 对可选物品跑标准 0-1
    n = len(optional)
    dp = [[0] * (remaining_cap + 1) for _ in range(n + 1)]
    
    for i in range(1, n + 1):
        w_i = optional[i - 1]["weight"]
        v_i = optional[i - 1]["value"]
        for c in range(remaining_cap + 1):
            not_take = dp[i - 1][c]
            take = dp[i - 1][c - w_i] + v_i if c >= w_i else 0
            dp[i][c] = max(not_take, take)
    
    # 回溯可选物品
    selected_opt = []
    c = remaining_cap
    for i in range(n, 0, -1):
        if dp[i][c] != dp[i - 1][c]:
            selected_opt.append(optional[i - 1])
            c -= optional[i - 1]["weight"]
    selected_opt.reverse()
    
    total_value = req_value + dp[n][remaining_cap]
    total_weight = req_weight + sum(s["weight"] for s in selected_opt)
    all_selected = required + selected_opt
    
    print(f"\n必投项目约束 (必选: {required_names}):")
    print(f"  必选物品重 {req_weight}g, 价值 {req_value}, 剩余容量 {remaining_cap}g")
    print(f"  最终选中: {[s['name'] for s in all_selected]}")
    print(f"  总重量: {total_weight}g, 总重要度: {total_value}")
    
    return total_value, all_selected


