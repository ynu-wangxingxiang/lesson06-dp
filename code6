def coin_greedy(coins, amount):
    """贪心算法：每步取 ≤ 余额的最大面额，拿完不回头。"""
    coins_sorted = sorted(coins, reverse=True)  # 降序排列
    result = []
    remaining = amount
    for coin in coins_sorted:
        while remaining >= coin:
            result.append(coin)
            remaining -= coin
    if remaining != 0:
        return None  # 无解
    return len(result), result


def coin_dp(coins, amount):
    """动态规划：dp[c] = 凑出 c 块最少几枚。地基 dp[0]=0。"""
    # 初始化：用一个不可能的大数表示"凑不出来"
    INF = float('inf')
    dp = [INF] * (amount + 1)
    dp[0] = 0  # 地基
    
    # 记录每一步最后一枚用的是哪种硬币，便于回溯
    last_coin = [0] * (amount + 1)
    
    for c in range(1, amount + 1):
        for coin in coins:
            if c >= coin and dp[c - coin] + 1 < dp[c]:
                dp[c] = dp[c - coin] + 1
                last_coin[c] = coin
    
    if dp[amount] == INF:
        return None, None
    
    # 回溯找出具体组合
    combination = []
    c = amount
    while c > 0:
        combination.append(last_coin[c])
        c -= last_coin[c]
    
    # 关键一行：dp[c] = 1 + min(dp[c-1], dp[c-5], dp[c-11])
    return dp[amount], sorted(combination, reverse=True)


def print_coin_dp_table(coins, amount):
    """打印凑硬币的 DP 表，展示填表过程。"""
    INF = float('inf')
    dp = [INF] * (amount + 1)
    dp[0] = 0
    last_coin = [0] * (amount + 1)
    
    for c in range(1, amount + 1):
        for coin in coins:
            if c >= coin and dp[c - coin] + 1 < dp[c]:
                dp[c] = dp[c - coin] + 1
                last_coin[c] = coin
    
    print(f"\n凑硬币 DP 表 (面额 {coins}, 金额 {amount}):")
    print("-" * 50)
    header = "金额: " + " ".join(f"{c:5d}" for c in range(amount + 1))
    values = "枚数: " + " ".join(f"{dp[c]:5d}" if dp[c] != INF else "  INF" for c in range(amount + 1))
    last = "末币: " + " ".join(f"{last_coin[c]:5d}" for c in range(amount + 1))
    print(header)
    print(values)
    print(last)
    print("-" * 50)
    return dp, last_coin


