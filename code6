# 独立研究 ①: n 皇后问题 (回溯法)
# ============================================================

def solve_n_queens(n):
    """
    n 皇后问题: 在 n×n 棋盘上放 n 个皇后, 互不攻击。
    回溯法: 一行一行尝试, 每次放一列, 检查冲突。
    """
    solutions = []
    board = [-1] * n  # board[row] = col, 每行皇后所在列
    
    def is_safe(row, col):
        """检查在 (row, col) 放皇后是否安全。"""
        for prev_row in range(row):
            prev_col = board[prev_row]
            # 同列 或 对角线冲突
            if prev_col == col or abs(prev_col - col) == row - prev_row:
                return False
        return True
    
    def backtrack(row):
        if row == n:
            solutions.append(board[:])
            return
        for col in range(n):
            if is_safe(row, col):
                board[row] = col
                backtrack(row + 1)
                board[row] = -1  # 撤销选择
    
    backtrack(0)
    return solutions


def demo_n_queens():
    """演示 n 皇后问题。"""
    print("\n" + "=" * 70)
    print("独立研究①: n 皇后问题 (回溯法)")
    print("=" * 70)
    
    for n in [4, 8]:
        sols = solve_n_queens(n)
        print(f"\n{n} 皇后: 共有 {len(sols)} 个解")
        if sols:
            print(f"  第一个解: 每行皇后位置 {sols[0]} (列号, 从0开始)")
            # 画棋盘
            board = sols[0]
            print(f"  棋盘示意 (Q=皇后):")
            for r in range(n):
                row_str = "  "
                for c in range(n):
                    row_str += "Q " if board[r] == c else ". "
                print(row_str)


