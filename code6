def budget_compare(items, original_cap=1000, new_cap=800):
    """对比不同预算下的最优解。"""
    print("\n" + "=" * 70)
    print("自主实践①: 预算对比 (1000g vs 800g)")
    print("=" * 70)
    
    # 原始预算
    _, sel_orig, _ = knapsack_01(items, original_cap, print_table=False)
    val_orig = sum(s['value'] for s in sel_orig)
    w_orig = sum(s['weight'] for s in sel_orig)
    
    # 新预算
    _, sel_new, _ = knapsack_01(items, new_cap, print_table=False)
    val_new = sum(s['value'] for s in sel_new)
    w_new = sum(s['weight'] for s in sel_new)
    
    print(f"\n预算 {original_cap}g:")
    print(f"  选中: {[s['name'] for s in sel_orig]}")
    print(f"  总重量: {w_orig}g, 总重要度: {val_orig}")
    
    print(f"\n预算 {new_cap}g:")
    print(f"  选中: {[s['name'] for s in sel_new]}")
    print(f"  总重量: {w_new}g, 总重要度: {val_new}")
    
    print(f"\n差异说明:")
    print(f"  - 预算减少 200g ({original_cap}→{new_cap}), 重要度损失 {val_orig - val_new} ({val_orig}→{val_new})")
    print(f"  - 1000g 时恰好装满 (睡袋350+食物400+水具250=1000), 重要度 315")
    print(f"  - 800g 时需要重新组合, 睡袋(350)+炉具(200)+食物(400)超重, 去掉睡袋改选帐篷(300)+食物(400)+水具(250)也超...")
    print(f"  - 实际上 800g 最优: 食物400+水具250+炉具200=850超, 睡袋350+炉具200+水具250=800恰好!")
    
    return val_orig, val_new


